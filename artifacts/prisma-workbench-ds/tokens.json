{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f8fafc" },
      "foreground": { "$value": "#0f172a" },
      "border": { "$value": "#e2e8f0" },
      "card": { "$value": "#ffffff" },
      "cardForeground": { "$value": "#0f172a" },
      "popover": { "$value": "#ffffff" },
      "popoverForeground": { "$value": "#0f172a" },
      "primary": {
        "$value": "#4f46e5",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#ffffff" },
      "secondary": { "$value": "#eef2ff" },
      "secondaryForeground": { "$value": "#3730a3" },
      "muted": { "$value": "#f1f5f9" },
      "mutedForeground": { "$value": "#64748b" },
      "accent": { "$value": "#eff6ff" },
      "accentForeground": { "$value": "#1e40af" },
      "destructive": { "$value": "#e11d48" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#cbd5e1" },
      "ring": { "$value": "#6366f1" },
      "chart1": { "$value": "#4f46e5" },
      "chart2": { "$value": "#059669" },
      "chart3": { "$value": "#d97706" },
      "chart4": { "$value": "#e11d48" },
      "chart5": { "$value": "#0284c7" },
      "sidebar": { "$value": "#ffffff" },
      "sidebarForeground": { "$value": "#475569" },
      "sidebarBorder": { "$value": "#e2e8f0" },
      "sidebarPrimary": { "$value": "#4f46e5" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#eef2ff" },
      "sidebarAccentForeground": { "$value": "#312e81" },
      "sidebarRing": { "$value": "#6366f1" }
    },
    "dark": {
      "background": { "$value": "#0f172a" },
      "foreground": { "$value": "#f8fafc" },
      "border": { "$value": "#334155" },
      "card": { "$value": "#111827" },
      "cardForeground": { "$value": "#f8fafc" },
      "popover": { "$value": "#111827" },
      "popoverForeground": { "$value": "#f8fafc" },
      "primary": { "$value": "#818cf8" },
      "primaryForeground": { "$value": "#1e1b4b" },
      "secondary": { "$value": "#1e293b" },
      "secondaryForeground": { "$value": "#e0e7ff" },
      "muted": { "$value": "#1e293b" },
      "mutedForeground": { "$value": "#94a3b8" },
      "accent": { "$value": "#172554" },
      "accentForeground": { "$value": "#dbeafe" },
      "destructive": { "$value": "#be123c" },
      "destructiveForeground": { "$value": "#fff1f2" },
      "input": { "$value": "#475569" },
      "ring": { "$value": "#a5b4fc" },
      "chart1": { "$value": "#818cf8" },
      "chart2": { "$value": "#34d399" },
      "chart3": { "$value": "#fbbf24" },
      "chart4": { "$value": "#fb7185" },
      "chart5": { "$value": "#38bdf8" },
      "sidebar": { "$value": "#111827" },
      "sidebarForeground": { "$value": "#cbd5e1" },
      "sidebarBorder": { "$value": "#334155" },
      "sidebarPrimary": { "$value": "#818cf8" },
      "sidebarPrimaryForeground": { "$value": "#ffffff" },
      "sidebarAccent": { "$value": "#1e293b" },
      "sidebarAccentForeground": { "$value": "#e0e7ff" },
      "sidebarRing": { "$value": "#a5b4fc" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Menlo", "ui-monospace", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
